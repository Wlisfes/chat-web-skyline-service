# Docker 部署环境变量；Skyline 业务配置统一从云端 Nacos 读取。
# 真实 .env 仅保存在部署主机，不要提交到 Git 仓库。

# Docker 容器内应用启动参数；服务监听端口固定为 5040。
NODE_ENV=production
PORT=5040

# Nacos 连接、鉴权和配置订阅参数。
NACOS_SERVER=10.66.0.1:8848
NACOS_SERVICE_NAME=chat-web-skyline-service
NACOS_NAMESPACE=replace-with-nacos-namespace-id
NACOS_CONFIG_DATA_ID=chat-web-skyline-service.yaml
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace-with-nacos-password

# Nacos 服务注册开关；失败是否阻止启动使用默认值 false。
NACOS_REGISTER_ENABLED=true
# Finance 服务间凭据临时覆盖（可选；优先在 Nacos security.serviceToken 配置，真实值不要提交）。
# FINANCE_SERVICE_TOKEN=replace-with-service-token
